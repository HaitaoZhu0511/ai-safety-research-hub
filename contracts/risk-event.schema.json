{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI safety risk event v0.2",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "scenario",
    "identity_ref",
    "policy_version",
    "intervention_point",
    "decision",
    "evidence_refs",
    "schema_version",
    "risk_ids",
    "reason_code",
    "request_digest",
    "sequence",
    "previous_hash",
    "event_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "identity_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string"
    },
    "intervention_point": {
      "enum": [
        "input",
        "retrieval",
        "dialog",
        "tool_proposal",
        "tool_result",
        "output",
        "publication"
      ]
    },
    "risk_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "content-harm",
          "prompt-injection",
          "privacy",
          "tool-authority",
          "provenance",
          "grounding",
          "eval-integrity",
          "resource-abuse",
          "fairness",
          "supply-chain",
          "capability-risk",
          "model-governance"
        ]
      },
      "uniqueItems": true
    },
    "decision": {
      "enum": [
        "allow",
        "block",
        "review",
        "restrict"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "execution_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "cost": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string"
    },
    "schema_version": {
      "const": "0.2"
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "previous_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "block",
              "review"
            ]
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "risk_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code": {
            "enum": [
              "executed",
              "idempotent_replay"
            ]
          }
        },
        "required": [
          "reason_code"
        ]
      },
      "then": {
        "required": [
          "execution_receipt_ref"
        ],
        "properties": {
          "decision": {
            "const": "allow"
          },
          "execution_receipt_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_code": {
            "const": "approval_issued"
          }
        },
        "required": [
          "reason_code"
        ]
      },
      "then": {
        "required": [
          "approval_ref"
        ],
        "properties": {
          "approval_ref": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "const": "allow"
          }
        }
      }
    }
  ]
}
